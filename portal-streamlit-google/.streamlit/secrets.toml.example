# Copie para .streamlit/secrets.toml e preencha as credenciais.
# NUNCA publique secrets.toml no GitHub.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE"
client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "SEU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[app]
# Lista fechada por padrão. Somente emails confirmados pelo Google terão acesso.
allowed_emails = ["seu.email@gmail.com"]

